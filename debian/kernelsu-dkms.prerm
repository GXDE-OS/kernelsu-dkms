#!/bin/sh
set -e

#DEBHELPER#

case "$1" in
    remove|purge|deconfigure)
        if command -v dkms >/dev/null 2>&1; then
            for src in /usr/src/kernelsu-*; do
                [ -d "$src" ] || continue
                version=${src##*kernelsu-}
                if dkms status -m kernelsu -v "$version" 2>/dev/null | grep -q .; then
                    dkms remove -m kernelsu -v "$version" --all || true
                fi
            done
        fi
        ;;
esac

exit 0
