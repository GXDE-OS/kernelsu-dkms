#!/bin/sh
set -e

#DEBHELPER#

case "$1" in
    remove|purge|deconfigure)
        if command -v dkms >/dev/null 2>&1; then
            for src in /usr/src/kernelsu-*; do
                [ -d "$src" ] || continue
                version=${src##*kernelsu-}
                if dkms status -m kernelsu -v "$version" 2>/dev/null | grep -q .; then
                    dkms remove -m kernelsu -v "$version" --all || true
                fi
            done
        fi
        # Drop the uncompressed loader copies published by the postinst
        # (kernelsu-loader / ksuinit read /lib/modules/<kver>/extra/kernelsu.ko).
        for ko in /lib/modules/*/extra/kernelsu.ko; do
            [ -f "$ko" ] || continue
            rm -f "$ko"
            kver=${ko#/lib/modules/}
            depmod -a "${kver%%/*}" 2>/dev/null || true
        done
        ;;
esac

exit 0
